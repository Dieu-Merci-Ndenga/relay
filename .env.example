DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
REDIS_URL=redis://localhost:6379
WEBHOOK_SECRET=dev-secret
DELIVERY_URL=http://localhost:4000/webhook-receiver
# DELIVERY_SECRET=            # defaults to WEBHOOK_SECRET
# ADMIN_TOKEN=                # required in production; Bearer token for dead-letters/attempts/retry
# METRICS_TOKEN=              # protects GET /metrics when set
# OUTBOX_SWEEP_INTERVAL_MS=30000
# OUTBOX_GRACE_MS=60000
# DELIVERY_TIMEOUT_MS=10000
# DELIVERY_MAX_ATTEMPTS=5
# DELIVERY_BACKOFF_MS=1000
# DELIVERY_CONCURRENCY=10
# RETRY_CONCURRENCY=5
FRONTEND_URL=http://localhost:5173